# Dark Matter Field Engine — Environment Variables
# The browser engine (index.html / dark-matter-field.html) requires NO environment variables.
# This file documents what a backend API server would need when the server layer is built.

# ── API SERVER (not yet built) ──────────────────────────────────────────────

# Port for the REST API server
PORT=3000

# CORS origin — restrict to your frontend domain in production
CORS_ORIGIN=https://uuon-foundation.github.io

# ── PERSISTENCE LAYER (not yet built) ───────────────────────────────────────
# For storing saved parameter states (P vectors) and user sessions

DATABASE_URL=postgresql://user:password@localhost:5432/dmf_engine

# ── OUTPUT STORAGE (not yet built) ──────────────────────────────────────────
# For storing generated GLB/OBJ artifacts

STORAGE_BUCKET=uuon-dmf-outputs
STORAGE_REGION=us-east-1

# ── INTERNAL NOTES ───────────────────────────────────────────────────────────
# The F=(P,E,R,C) API would expose endpoints:
#   POST /api/v1/encode   — accept P, return computed mesh data
#   GET  /api/v1/decode   — accept P as query params, stream GLB
#   POST /api/v1/bake     — accept P + frame config, return animated GLB
# See api/README.md for full planned stack.
